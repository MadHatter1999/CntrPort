rules_version = '2';

// European New Market - Firestore security rules.
// Customers (unauthenticated) may CREATE orders and Meest requests from the
// storefront. Only signed-in staff may read, update or delete them. No card
// numbers or CVCs are ever written here (only brand + last4).
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null;
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'total', 'createdAt'])
                    && !('cardNumber' in request.resource.data)
                    && !('cvc' in request.resource.data);
      allow read, update, delete: if isStaff();
    }

    match /meest/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'createdAt']);
      allow read, update, delete: if isStaff();
    }

    // Everything else is staff-only by default.
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
