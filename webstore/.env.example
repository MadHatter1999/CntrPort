# Copy to ".env" (git-ignored) and fill in.

# --- Storefront API (CntrPort wrapper) ---
# Origin of the CntrPort wrapper that serves /api/store/*.
#   Leave BLANK for local dev/preview: vite.config.ts proxies /api to the wrapper
#   (set WRAPPER_URL there if it isn't http://localhost:5000), so there's no CORS.
#   In production, leave blank and serve dist/ behind the same origin as the
#   wrapper, OR set this to the wrapper's URL and enable CORS on the wrapper.
VITE_STORE_API_BASE=
# Only needed if the wrapper enforces its API key (CNTRPORT_API_KEY). Note: a key
# placed here ships in the public bundle, so prefer leaving the read endpoints
# open and gating writes at the network layer.
VITE_STORE_API_KEY=
VITE_STORE_API_KEY_HEADER=X-API-Key

# --- Firebase (optional) ---
# For the admin login + cross-device order sync. Leave unset to run in local/demo
# mode (localStorage + demo admin gate). Fill from Firebase console → Project
# settings → Your apps → SDK setup & config. After setting them: enable
# Email/Password sign-in, create staff account(s), and deploy firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
