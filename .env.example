# --- NCR Counterpoint API ---
CP_API_BASE_URL=https://localhost:52000
# Company alias prefix used in Basic Auth as "<CP_COMPANY_ALIAS>.<CP_API_USERNAME>".
CP_COMPANY_ALIAS=YourCompany
CP_API_USERNAME=MGR
CP_API_PASSWORD=changeme
CP_API_KEY=changeme
# Header name the Counterpoint API expects for the API key.
# The guide commonly uses "APIKey". Adjust if your install differs.
CP_API_KEY_HEADER=APIKey
# Self-signed certs on local installs: set to false to disable verification.
CP_API_VERIFY_SSL=true
# When true, callers can opt out of the hook pipeline per-request with
#   ?_direct=1   (query string)   OR   X-CntrP-Mode: direct   (header)
# The request then forwards to NCR raw and the response is returned unmodified.
# Default false to keep redact / compliance hooks reliable in production.
# Recommended: leave false in production; enable for dev / staging.
CP_ALLOW_DIRECT_MODE=false

# --- Wrapper-level API key (this wrapper's own auth) ---
# When set, every caller must send this value in the header named by
# CNTRPORT_API_KEY_HEADER. Leave blank to keep the wrapper open and rely
# on network-level auth only. This is the *caller's* key into this wrapper;
# it is NOT forwarded to NCR (CP_API_KEY above handles upstream auth).
CNTRPORT_API_KEY=
CNTRPORT_API_KEY_HEADER=X-API-Key
# Comma-separated list of paths that bypass the key check (uptime probes, etc.).
CNTRPORT_AUTH_EXEMPT_PATHS=/api/health

# --- Microsoft SQL Server (optional - only needed by the SQL extension helpers) ---
CP_SQL_SERVER=.
CP_SQL_DATABASE=YourCompany
CP_SQL_USER=sa
CP_SQL_PASSWORD=changeme
CP_SQL_DRIVER=ODBC Driver 17 for SQL Server

# --- Storefront (webstore/) ---
# The web store reads its catalog, categories and locations live from
# Counterpoint. These cover the few presentation values CP doesn't model.
# Leave STORE_NAME blank to use the Counterpoint company name.
STORE_NAME=
STORE_CURRENCY=USD
# Storefront tax rate as a decimal (e.g. 0.15 for 15%). 0 = no tax line.
STORE_TAX_RATE=0
# Counterpoint location + customer that web orders are written against.
STORE_DEFAULT_LOC_ID=MAIN
STORE_DEFAULT_CUST_NO=WEB

# --- Flask ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
