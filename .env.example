# --- NCR Counterpoint API ---
CP_API_BASE_URL=https://localhost:52000
# Company alias prefix used in Basic Auth as "<CP_COMPANY_ALIAS>.<CP_API_USERNAME>".
CP_COMPANY_ALIAS=YourCompany
CP_API_USERNAME=MGR
CP_API_PASSWORD=changeme
CP_API_KEY=changeme
# Header name the Counterpoint API expects for the API key.
# The guide commonly uses "APIKey". Adjust if your install differs.
CP_API_KEY_HEADER=APIKey
# Self-signed certs on local installs: set to false to disable verification.
CP_API_VERIFY_SSL=true
# When true, callers can opt out of the hook pipeline per-request with
#   ?_direct=1   (query string)   OR   X-CntrP-Mode: direct   (header)
# The request then forwards to NCR raw and the response is returned unmodified.
# Default false to keep redact / compliance hooks reliable in production.
# Recommended: leave false in production; enable for dev / staging.
CP_ALLOW_DIRECT_MODE=false

# --- Microsoft SQL Server (optional - only needed by the SQL extension helpers) ---
CP_SQL_SERVER=.
CP_SQL_DATABASE=YourCompany
CP_SQL_USER=sa
CP_SQL_PASSWORD=changeme
CP_SQL_DRIVER=ODBC Driver 17 for SQL Server

# --- Flask ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
